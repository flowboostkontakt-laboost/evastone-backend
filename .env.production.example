# Produkcja na VM (Oracle Always Free). Skopiuj do `.env.production` i uzupełnij.
# NIE commituj .env.production (jest w .gitignore).

APP_NAME=EvaStone
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:TCljdBAU6LWUn50VOYU2LxeaXnn7gyEMBf2iVd98uWA=
APP_LOCALE=de
APP_FALLBACK_LOCALE=de

# domena dla HTTPS: prawdziwa (np. evastone.eu) albo <PUBLIC_IP>.sslip.io
DOMAIN=your-vm-ip.sslip.io
APP_URL=https://your-vm-ip.sslip.io

# --- baza aplikacji: MySQL w kontenerze (jak lokalnie) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=evastone
DB_USERNAME=evastone
DB_PASSWORD=zmien_to_mocne_haslo
DB_ROOT_PASSWORD=zmien_to_rootowe_haslo

# --- Redis (kontener) ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database

# --- media na dysku VM (bez S3/R2) ---
FILESYSTEM_DISK=public
MEDIA_DISK=public

# --- import katalogu ze zdalnej bazy ComUp (read-only) ---
COMUP_LEGACY_HOST=kacper.comup.pl
COMUP_LEGACY_PORT=3306
COMUP_LEGACY_DATABASE=16518162_0000175
COMUP_LEGACY_USERNAME=16518162_0000175
COMUP_LEGACY_PASSWORD=
COMUP_UPLOAD_BASE=https://evastone.comup.pl

# --- RODO / newsletter ---
IP_PEPPER=zmien_to_losowe
NEWSLETTER_CONSENT_VERSION=nl-2026-08-1

# --- mail: log do czasu konfiguracji SMTP (CTO, dok. 07 §6) ---
MAIL_MAILER=log
