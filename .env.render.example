# Szablon zmiennych pod Render (uzupełniane w panelu jako sekrety).
# Wartości z fromDatabase/fromService/generateValue Render wypełnia sam —
# tu tylko te, które podajesz ręcznie (sync:false w render.yaml).

APP_KEY=base64:...            # php artisan key:generate --show
APP_URL=https://evastone-web.onrender.com

# zdalna baza ComUp (do jednorazowego importu katalogu; te same dane co lokalnie)
COMUP_LEGACY_DATABASE=16518162_0000175
COMUP_LEGACY_USERNAME=16518162_0000175
COMUP_LEGACY_PASSWORD=

# Cloudflare R2 (media) — utwórz bucket, wygeneruj token S3-API
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=evastone-media
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
